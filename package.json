{
  "name": "@atomiqlabs/messenger-nostr",
  "version": "2.2.0",
  "description": "",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist-esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist-esm/index.d.ts",
        "default": "./dist-esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist-esm/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "node -e \"for (const dir of ['dist', 'dist-esm']) require('node:fs').rmSync(dir, {recursive: true, force: true})\"",
    "build:cjs": "npx -p typescript@5.9 tsc -p tsconfig.json",
    "build:esm": "npx -p typescript@5.9 tsc -p tsconfig.esm.json && node -e \"require('node:fs').copyFileSync('package.esm.json', 'dist-esm/package.json')\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:ts5": "npx -p typescript@5.9 tsc --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "/dist",
    "/dist-esm",
    "/src"
  ],
  "keywords": [
    "Solana",
    "Bitcoin",
    "Cross-chain",
    "Cryptocurrency",
    "Bridge",
    "Trustless"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@atomiqlabs/base": "^13.0.4",
    "nostr-tools": "2.20.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "typescript": ">=5"
  }
}
